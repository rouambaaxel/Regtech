# ============================================================
# ComplianceOS — Variables d'environnement
# Copier en .env et remplir les valeurs
# ============================================================

# PostgreSQL
# Local : postgresql://postgres:password@localhost:5432/complianceos
# Prod  : Railway / Supabase / Render fourni automatiquement
DATABASE_URL=postgresql://user:password@localhost:5432/complianceos

# JWT
JWT_SECRET=change_me_in_production_use_secrets_manager_min_32_chars

# Companies House API (GRATUIT)
# Créer une clé sur : https://developer.company-information.service.gov.uk/get-started
CH_API_KEY=your_companies_house_api_key

# NameScan (Sanctions + PEP)
# https://namescan.io — free tier web, API à partir de £50/mois
NAMESCAN_API_KEY=your_namescan_api_key

# Dilisense (alternative/complément à NameScan)
# https://dilisense.com — free tier disponible
DILISENSE_API_KEY=your_dilisense_api_key

# ComplyCube (IDV — vérification identité personnes physiques)
# https://complycube.com — pay-per-use ~£0.50/check
COMPLYCUBE_API_KEY=your_complycube_api_key

# Stripe (facturation SaaS)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App config
APP_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://app.complianceos.io
